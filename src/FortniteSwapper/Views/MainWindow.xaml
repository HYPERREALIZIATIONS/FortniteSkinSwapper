<Window x:Class="FortniteSwapper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FortniteSwapper.ViewModels"
        xmlns:views="clr-namespace:FortniteSwapper.Views"
        Title="Fortnite Swapper"
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowseViewModel}">
            <views:BrowseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SwapViewModel}">
            <views:SwapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Style="{StaticResource SidebarStyle}">
            <TextBlock Text="FORTNITE&#10;SWAPPER" Style="{StaticResource BrandStyle}" />
            <Button Content="Home" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource NavButtonStyle}" />
            <Button Content="Browse" Command="{Binding NavigateCommand}" CommandParameter="Browse" Style="{StaticResource NavButtonStyle}" />
            <Button Content="Swap" Command="{Binding NavigateCommand}" CommandParameter="Swap" Style="{StaticResource NavButtonStyle}" />
            <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavButtonStyle}" />
            <TextBlock Margin="16,24,16,0" Style="{StaticResource MutedText}" FontSize="11">
                Cosmetic-only, local file changes. Not affiliated with Epic Games.
            </TextBlock>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding Current}" Margin="22" />
    </Grid>
</Window>
